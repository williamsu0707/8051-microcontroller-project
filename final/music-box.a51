T0_COUNT EQU 62500
SPK      EQU P3.7
TIMES    EQU 30H
H_TMP    EQU 31H
L_TMP    EQU 32H
SEG7     EQU P0

ORG 0H
JMP SETTING
ORG 03H
JMP SUB_INT0
ORG 0BH 
JMP TIMER0_INT
ORG 13H
JMP SUB_INT1
ORG 1BH
JMP TIMER1_INT

SETTING:
    MOV IE, #10001111B    ; Enable Timer0, INT0, INT1, Timer1, and Global Interrupts
    MOV IP, #00000001B    ; Set Timer0 as high priority
    MOV SP, #70H          ; Set Stack Pointer
    MOV TMOD, #00010001B  ; Timer0 and Timer1 mode settings
    MOV TL0, #(65536-T0_COUNT) MOD 256
    MOV TH0, #(65536-T0_COUNT) / 256
    MOV DPTR, #TABLE1 
    MOV R1, #0 
    MOV R5, #1 
    SETB TR0 
    SETB IT0              ; Configure INT0 as edge triggered
    SETB IT1              ; Configure INT1 as edge triggered

MAIN:
    MOV  A, R1
    MOVC A, @A+DPTR
    MOV  TIMES, A
    CJNE A, #255, SOUND
    MOV  R1, #0
    JMP  MAIN

SOUND:
    CALL READ_TONE
SOUND1: 
    MOV A, TIMES 
    CJNE A, #0, SOUND1 
    CLR TR1
    INC R1
    JMP MAIN

READ_TONE:
    INC  R1
    MOV  A, R1
    MOVC A, @A+DPTR
    MOV  H_TMP, A
    MOV  TH1, H_TMP
    INC  R1
    MOV  A, R1
    MOVC A, @A+DPTR
    MOV  L_TMP, A
    MOV  TL1, L_TMP
    MOV  A, H_TMP
    CJNE A, #0, SPK_WORK
    CLR  TR1

SPK_WORK:
    SETB TR1
    RET

TIMER0_INT:
    PUSH ACC
    PUSH PSW
    DEC  TIMES
    MOV  TL0, #(65536-T0_COUNT) MOD 256
    MOV  TH0, #(65536-T0_COUNT) / 256
    SETB TR0
    POP  PSW
    POP  ACC
    RETI

TIMER1_INT:
    PUSH ACC
    PUSH PSW
    CPL  SPK
    MOV  TH1, H_TMP
    MOV  TL1, L_TMP
    SETB TR1
    POP  PSW
    POP  ACC
    RETI

SUB_INT0:
    INC R5
    CJNE R5, #4, DONE0
    MOV R5, #1
DONE0: 
    MOV DPTR, #NUM_TABLE   
    MOV A, R5
    MOVC A, @A+DPTR
    MOV SEG7, A
    CJNE R5, #1, NEXT_SONG
    MOV DPTR, #TABLE1
    JMP DONE0_2
    
NEXT_SONG:
    CJNE R5, #2, NEXT_SONG1
    MOV DPTR, #TABLE2
    JMP DONE0_2
    
NEXT_SONG1:
    CJNE R5, #3, NEXT_SONG2
    MOV DPTR, #TABLE3
    JMP DONE0_2
    
NEXT_SONG2:
    MOV DPTR, #TABLE1

DONE0_2:
    RETI

SUB_INT1:
    DEC R5
    CJNE R5, #0, DONE1
    MOV R5, #3
DONE1: 
    MOV DPTR, #NUM_TABLE   
    MOV A, R5
    MOVC A, @A+DPTR
    MOV SEG7, A
    CJNE R5, #1, PREV_SONG
    MOV DPTR, #TABLE1
    JMP DONE2
    
PREV_SONG:
    CJNE R5, #2, PREV_SONG1
    MOV DPTR, #TABLE2
    JMP DONE2
    
PREV_SONG1:
    CJNE R5, #3, PREV_SONG2
    MOV DPTR, #TABLE3
    JMP DONE2
    
PREV_SONG2:
    MOV DPTR, #TABLE1

DONE2:
    RETI

NUM_TABLE:
    DB 11111100B
    DB 01100000B
    DB 11011010B
    DB 11110010B

NUM_TABLE4:
    DB 11110010B
    DB 11011010B
    DB 01100000B
    DB 11111100B
		
TABLE1:
DB 8, 253, 131
DB 8, 253, 10
DB 16, 253, 10
DB 1, 0, 0
DB 8, 253, 52
DB 8, 252, 173
DB 16, 252, 173
DB 1, 0, 0
DB 8, 252, 68 
DB 8, 252, 173
DB 8, 253, 10
DB 16, 253, 52
DB 1, 0, 0 
DB 8, 253, 131
DB 8, 253, 131
DB 16, 253, 131
DB 1, 0, 0 
DB 8, 253, 131
DB 8, 253, 10
DB 16, 253, 10
DB 1, 0, 0
DB 8, 253, 52
DB 8, 252, 173
DB 16, 252, 173
DB 1, 0, 0
DB 8, 252, 68
DB 8, 253, 10
DB 8, 253, 131
DB 16, 253, 131
DB 1, 0, 0
DB 16, 252, 68
DB 1, 0, 0

